# ==========================================
# Nigerian Dictionary Environment Template
# Copy this file to `.env.local` or `.env`
# ==========================================

# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?sslmode=require"
# Unpooled Direct Database Connection (Used for Prisma migrations on Neon)
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/mydb?sslmode=require"

# Neon Auth Configuration
NEXT_PUBLIC_NEON_AUTH_BASE_URL=""
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET="super-secret-random-cookie-secret-min-32-chars"

# Encryption Key (Used for encrypting user API keys and sensitive tokens with AES-256)
ENCRYPTION_KEY="your-secure-random-encryption-key-32-chars"

# Better Auth & Security
BETTER_AUTH_SECRET="your-secure-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Superadmin Email Whitelist (Comma-separated)
SUPERADMIN_EMAILS="admin@example.com"

# Email Dispatch (Resend API - Free Tier: 3,000 emails/month)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
EMAIL_FROM="The Nigerian Dictionary <onboarding@resend.dev>"

# Identity Verification KYC (Dojah API - Optional for NIN verification)
DOJAH_API_KEY=""
DOJAH_APP_ID=""

# Search APIs (AI RAG Assistance)
SERPER_API_KEY=""
TAVILY_API_KEY=""

# AI Engine
OPENROUTER_API_KEY=""

# Algolia Instant Search
NEXT_PUBLIC_ALGOLIA_APP_ID=""
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=""
ALGOLIA_ADMIN_KEY=""
