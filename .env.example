# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Better Auth & Security
BETTER_AUTH_SECRET="your-secure-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Superadmin Email Whitelist (Comma-separated)
SUPERADMIN_EMAILS="admin@example.com"

# Email Dispatch (Resend API - Free Tier)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Search APIs (AI RAG Assistance)
SERPER_API_KEY=""
TAVILY_API_KEY=""

# AI Engine
OPENROUTER_API_KEY=""

# Algolia Instant Search
NEXT_PUBLIC_ALGOLIA_APP_ID=""
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=""
ALGOLIA_ADMIN_KEY=""
