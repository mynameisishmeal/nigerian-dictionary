# ==========================================
# Nigerian Dictionary .gitignore
# ==========================================

# 1. Environment & Sensitive Secrets (CRITICAL)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example

# 2. Private Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
id_rsa
id_rsa.pub

# 3. Database Dumps & Local Database Files
*.sql
*.dump
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
prisma/*.db
prisma/*.db-journal

# 4. Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 5. Build Artifacts & Caches
/.next/
/out/
/build/
/dist/
/.turbo/
/.vercel/
.neon
.neon/
*.neon
*.tsbuildinfo
next-env.d.ts

# 6. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 7. Operating System & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 8. IDE & Editor Configs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 9. Scratch Scripts & Temporary Tests
scripts/temp-*
scripts/test-*
scratch/
/scratch/
scratch_*.*
scratch_*.ts
scratch_*.js
scratch_*.mjs
scratch_*.cjs
